{
  "name": "simple-note",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A tiny URL-based notepad that saves on blur.",
  "scripts": {
    "build": "esbuild public/app.js --bundle --outfile=public/bundle.js --minify",
    "start": "npm run build && node server.js",
    "test": "node --test",
    "cleanup": "node cleanup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-code-block-lowlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "dompurify": "^3.4.11",
    "lowlight": "^3.3.0",
    "marked": "^18.0.5",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "pkg": "^5.8.1"
  }
}
